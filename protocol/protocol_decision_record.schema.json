{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ftw-turkiye:protocol-decision-record-schema:1.1.0",
  "title": "Use-conditioned GeoAI due-diligence decision record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "record_id",
    "created_at",
    "code_revision",
    "product",
    "intended_use",
    "stages",
    "final_action",
    "final_rationale",
    "restrictions",
    "unresolved_evidence_gaps"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "record_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "code_revision": {"type": "string", "minLength": 7},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "immutable_input_identifier"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "immutable_input_identifier": {"type": "string", "minLength": 1},
        "target_ontology": {"type": "string"},
        "included_classes": {"type": "array", "items": {"type": "string"}},
        "excluded_classes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "intended_use": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "use_statement",
        "risk_level",
        "mandatory_requirements",
        "prohibited_inferences"
      ],
      "properties": {
        "use_statement": {"type": "string", "minLength": 1},
        "decision_context": {"type": "string"},
        "risk_level": {"enum": ["low", "moderate", "high", "critical"]},
        "mandatory_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "prohibited_inferences": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage_id": {"const": 0}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage_id": {"const": 1}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage_id": {"const": 2}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage_id": {"const": 3}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage_id": {"const": 4}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage_id": {"const": 5}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage_id": {"const": 6}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage_id": {"const": 7}}}]},
        {"allOf": [{"$ref": "#/$defs/stage"}, {"properties": {"stage_id": {"const": 8}}}]}
      ],
      "items": false
    },
    "final_action": {
      "enum": [
        "adopt",
        "adopt_with_restrictions",
        "external_validation_required",
        "reject_for_declared_use"
      ]
    },
    "final_rationale": {"type": "string", "minLength": 1},
    "restrictions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "unresolved_evidence_gaps": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"final_action": {"const": "adopt_with_restrictions"}}},
      "then": {"properties": {"restrictions": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"final_action": {"const": "adopt"}}},
      "then": {
        "properties": {
          "restrictions": {"maxItems": 0},
          "unresolved_evidence_gaps": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "stage_name",
        "applicability",
        "evidence_required",
        "acceptance_criterion",
        "observed_evidence",
        "outcome",
        "allowed_action",
        "evidence_artifacts"
      ],
      "properties": {
        "stage_id": {"type": "integer", "minimum": 0, "maximum": 8},
        "stage_name": {"type": "string", "minLength": 1},
        "applicability": {"enum": ["mandatory", "conditional", "not_applicable"]},
        "evidence_required": {"type": "string", "minLength": 1},
        "acceptance_criterion": {"type": "string", "minLength": 1},
        "observed_evidence": {"type": "string", "minLength": 1},
        "outcome": {
          "enum": ["pass", "fail", "indeterminate", "not_applicable"]
        },
        "allowed_action": {
          "enum": [
            "continue",
            "continue_with_restriction",
            "external_validation_required",
            "stop",
            "not_applicable"
          ]
        },
        "evidence_artifacts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"applicability": {"const": "not_applicable"}}},
          "then": {
            "properties": {
              "outcome": {"const": "not_applicable"},
              "allowed_action": {"const": "not_applicable"},
              "evidence_artifacts": {"maxItems": 0}
            }
          },
          "else": {
            "properties": {
              "outcome": {"not": {"const": "not_applicable"}},
              "allowed_action": {"not": {"const": "not_applicable"}},
              "evidence_artifacts": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {"enum": ["fail", "indeterminate"]}
            }
          },
          "then": {
            "properties": {
              "allowed_action": {
                "enum": [
                  "continue_with_restriction",
                  "external_validation_required",
                  "stop"
                ]
              }
            }
          }
        },
        {
          "if": {"properties": {"allowed_action": {"const": "stop"}}},
          "then": {"properties": {"outcome": {"const": "fail"}}}
        },
        {
          "if": {
            "properties": {
              "allowed_action": {"const": "external_validation_required"}
            }
          },
          "then": {
            "properties": {
              "outcome": {"enum": ["fail", "indeterminate"]}
            }
          }
        }
      ]
    }
  }
}
